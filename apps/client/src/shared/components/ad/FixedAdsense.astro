---
/** 포스트 상단과 PC 사이드바에 고정 크기 광고 예약 영역을 렌더링한다. */

import AdvertisementSlot from "./AdSlot.astro";
import { ADVERTISEMENT_SLOT_KEY } from "@/shared/constants/ad";
import type { Locale } from "@/shared/types/common";
import { t } from "@/shared/lib/i18n/translations";

interface Props {
  variant: "post-top" | "sidebar";
  locale: Locale;
}

const { variant, locale } = Astro.props;
---

{variant === "post-top" && (
  <AdvertisementSlot
    class="mb-6 mx-auto h-[50px] min-h-[50px] w-[300px] lg:h-[60px] lg:min-h-[60px] lg:w-[468px]"
    slotId="post_top"
    format="display"
    position="post_top"
    slotKey={ADVERTISEMENT_SLOT_KEY.postTop}
    advertisementLabel={t("a11y.advertisement", locale)}
    loadStrategy="immediate"
  />
)}

{variant === "sidebar" && (
  <AdvertisementSlot
    class="h-[250px] min-h-[250px] w-[300px]"
    slotId="sidebar"
    format="display"
    position="right_sidebar"
    slotKey={ADVERTISEMENT_SLOT_KEY.sidebar}
    advertisementLabel={t("a11y.advertisement", locale)}
  />
)}
