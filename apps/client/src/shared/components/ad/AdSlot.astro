---
/** 고정 크기 예약 영역을 제공하고 광고 중재 런타임에 슬롯 메타데이터를 전달한다. */

import {
  ADVERTISEMENT_MEDIATION_CONFIG,
  type AdvertisementSlotKey,
} from "@/shared/constants/ad";

interface Props {
  class?: string;
  slotId: string;
  format: "display" | "in_feed";
  position: string;
  slotKey: AdvertisementSlotKey;
  advertisementLabel: string;
  loadStrategy?: "immediate" | "lazy";
  fallbackIndex?: number;
}

const {
  class: className,
  slotId,
  format,
  position,
  slotKey,
  advertisementLabel,
  loadStrategy = "lazy",
  fallbackIndex = 0,
} = Astro.props;

const slotConfig = ADVERTISEMENT_MEDIATION_CONFIG.slots[slotKey];
---

{slotConfig.enabled && (
  <div
    class:list={["relative", className]}
    data-advertisement-label={advertisementLabel}
    data-ad-slot={slotId}
    data-ad-slot-key={slotKey}
    data-ad-format={format}
    data-ad-position={position}
    data-ad-placement={slotConfig.placement}
    data-ad-load-strategy={loadStrategy}
    data-ad-fallback-index={fallbackIndex}
    data-ad-active-provider="none"
  ></div>
)}
