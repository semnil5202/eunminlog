---
/** 피드와 검색 결과에 높이가 유동적인 Native In-feed 광고 예약 영역을 렌더링한다. */

import AdvertisementSlot from "./AdSlot.astro";
import type { AdvertisementPlacement } from "@/shared/constants/ad";
import type { Locale } from "@/shared/types/common";
import { t } from "@/shared/lib/i18n/translations";

interface Props {
  class?: string;
  slotId?: string;
  position?: string;
  placement?: AdvertisementPlacement;
  fallbackIndex?: number;
  locale: Locale;
}

const {
  class: className,
  slotId = "feed",
  position = "feed",
  placement = "feed",
  fallbackIndex = 0,
  locale,
} = Astro.props;
---

<AdvertisementSlot
  class={className}
  slotId={slotId}
  format="in_feed"
  position={position}
  placement={placement}
  advertisementLabel={t("a11y.advertisement", locale)}
  fallbackIndex={fallbackIndex}
/>
