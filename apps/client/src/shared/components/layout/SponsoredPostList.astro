---
/** 인기글 리스트. RightSidebar(PC)와 게시글 하단(모바일) 공용. */

import { t } from "@/shared/lib/i18n/translations";
import type { Locale } from "@/shared/types/common";
import type { LocalizedPost } from "@/shared/types/post";
import InFeedAdsense from "@/shared/components/ad/InFeedAdsense.astro";
import AdvertisementSlot from "@/shared/components/ad/AdSlot.astro";
import { ADVERTISEMENT_SLOT_KEY } from "@/shared/constants/ad";
import SponsoredPostItem from "./SponsoredPostItem.astro";

interface Props {
  locale: Locale;
  posts: LocalizedPost[];
  currentSlug?: string;
  title?: string;
  showInFeedAdvertisement?: boolean;
  advertisementContext?: "sidebar" | "mobile";
}

const {
  locale,
  posts,
  currentSlug,
  title,
  showInFeedAdvertisement = false,
  advertisementContext = "sidebar",
} = Astro.props;
const popularLabel = title ?? t("sidebar.popular", locale);
const emptyLabel = t("sidebar.popularEmpty", locale);
const shouldShowInFeedAdvertisement = showInFeedAdvertisement && posts.length >= 3;
---

<section class="sponsored-post-list">
  <h2 class="text-[16px] font-bold text-primary-600 pb-2 border-b border-gray-200">
    {popularLabel}
  </h2>

  {posts.length > 0 ? (
    <>
      <ul role="list">
        {posts.slice(0, 2).map((post) => (
          <SponsoredPostItem post={post} currentSlug={currentSlug} locale={locale} />
        ))}
      </ul>

      {shouldShowInFeedAdvertisement && (
        advertisementContext === "mobile" ? <InFeedAdsense
          class="h-[150px] max-h-[150px] min-h-[112px] w-full"
          slotId="mobile_popular_list_in_feed"
          position="mobile_popular_list_after_2"
          slotKey={ADVERTISEMENT_SLOT_KEY.popularList}
          locale={locale}
        /> : <AdvertisementSlot
          class="mx-auto h-[100px] min-h-[100px] max-h-[100px] w-[300px]"
          slotId="popular_list_fixed"
          format="display"
          position="popular_list_after_2"
          slotKey={ADVERTISEMENT_SLOT_KEY.popularListDesktop}
          advertisementLabel={t("a11y.advertisement", locale)}
        />
      )}

      {posts.length > 2 && (
        <ul role="list" class="border-t border-gray-100">
          {posts.slice(2, 4).map((post) => (
            <SponsoredPostItem post={post} currentSlug={currentSlug} locale={locale} />
          ))}
        </ul>
      )}
    </>
  ) : (
    <p class="text-caption1 text-gray-400 text-center py-6">{emptyLabel}</p>
  )}
</section>

<script>
  import { trackEvent } from "@/shared/lib/analytics/gtag";

  document.querySelectorAll<HTMLElement>(".sponsored-post-list").forEach((container) => {
    container.addEventListener("click", (event) => {
      const postElement = (event.target as HTMLElement).closest<HTMLElement>("[data-post-slug]");
      if (!postElement) return;
      trackEvent("select_content", {
        content_type: "post",
        content_slug: postElement.dataset.postSlug!,
        content_category: postElement.dataset.postCategory!,
        content_sub_category: postElement.dataset.postSubCategory!,
        is_sponsored: postElement.dataset.postSponsored === "true",
      });
    });
  });
</script>
