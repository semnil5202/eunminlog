---
/** PC 전용 우측 사이드바. 애드센스 영역과 인기글 리스트를 표시한다. */

import SponsoredPostList from "@/shared/components/layout/SponsoredPostList.astro";
import FixedAdsense from "@/shared/components/ad/FixedAdsense.astro";
import type { Locale } from "@/shared/types/common";
import { t } from "@/shared/lib/i18n/translations";
import type { LocalizedPost } from "@/shared/types/post";

interface Props {
  locale: Locale;
  sponsoredPosts?: LocalizedPost[];
  currentSlug?: string;
  popularTitle?: string;
}

const { locale, sponsoredPosts = [], currentSlug, popularTitle } = Astro.props;
---

<aside
  class="hidden lg:block w-[300px] shrink-0"
  aria-label={t("a11y.sponsoredSidebar", locale)}
>
  <div class="sticky top-20 max-h-[calc(100vh-5rem)] overflow-y-auto scrollbar-none pt-2 pb-6 space-y-8">

    <FixedAdsense variant="sidebar" locale={locale} />

    <SponsoredPostList
      locale={locale}
      posts={sponsoredPosts}
      currentSlug={currentSlug}
      title={popularTitle}
    />

  </div>
</aside>
