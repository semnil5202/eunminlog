---
/** 포스트 상세의 상태 뱃지 조합. */

import PostBadge from "@/shared/components/ui/PostBadge.astro";

interface Props {
  isSponsored: boolean;
  isRecommended: boolean;
  sponsoredLabel: string;
  popularLabel: string;
}

const { isSponsored, isRecommended, sponsoredLabel, popularLabel } = Astro.props;
const badgeLabel = isSponsored ? sponsoredLabel : isRecommended ? popularLabel : undefined;
---

{badgeLabel && (
  <div class="flex gap-2 mb-3">
    <PostBadge label={badgeLabel} />
  </div>
)}
