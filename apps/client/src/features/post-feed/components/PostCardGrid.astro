---
/** 포스트 피드를 단일 컬럼 리스트로 렌더링한다. 2번째, 5번째 슬롯에 인피드 광고 삽입. */
import type { LocalizedPost } from "@/shared/types/post";
import type { Locale } from "@/shared/types/common";
import { t } from "@/shared/lib/i18n/translations";
import PostCard from "./PostCard.astro";
import SponsoredCard from "./SponsoredCard.astro";
import InFeedAdsense from "@/shared/components/ad/InFeedAdsense.astro";

interface Props {
  posts: LocalizedPost[];
  locale: Locale;
  feedEndpoint?: string;
  hasNextPage?: boolean;
  sponsoredLabel?: string;
  popularLabel?: string;
}

const { posts, locale, feedEndpoint, hasNextPage = false, sponsoredLabel = "", popularLabel = "" } = Astro.props;

type FeedItem =
  | { type: "post"; post: LocalizedPost; cardIndex: number }
  | { type: "advertisement"; positionIndex: number; fallbackIndex: number };

const feedItems: FeedItem[] = [];
let cardIndex = 0;
let advertisementIndex = 0;

for (let index = 0; index < posts.length; index++) {
  if (cardIndex === 1 || cardIndex === 4) {
    feedItems.push({
      type: "advertisement",
      positionIndex: cardIndex,
      fallbackIndex: advertisementIndex,
    });
    advertisementIndex++;
  }

  feedItems.push({ type: "post", post: posts[index]!, cardIndex });
  cardIndex++;
}
---

<div
  id="post-feed"
  class="flex flex-col gap-10"
  data-feed-endpoint={feedEndpoint}
  data-next-page="2"
  data-has-next={String(hasNextPage)}
  data-sponsored-label={sponsoredLabel}
  data-popular-label={popularLabel}
  data-ad-label={t("a11y.advertisement", locale)}
  data-initial-post-count={posts.length}
>
  {feedItems.map((item) => {
    if (item.type === "advertisement") {
      return (
        <InFeedAdsense
          class="w-full min-h-[250px]"
          slotId={`feed_card_index_${item.positionIndex}`}
          position={`feed_card_index_${item.positionIndex}`}
          placement="feed"
          fallbackIndex={item.fallbackIndex}
          locale={locale}
        />
      );
    }

    if (item.post.is_sponsored || item.post.is_recommended) {
      return (
        <SponsoredCard
          post={item.post}
          locale={locale}
          index={item.cardIndex}
        />
      );
    }

    return (
      <PostCard
        post={item.post}
        locale={locale}
        index={item.cardIndex}
        sponsoredLabel={sponsoredLabel}
        popularLabel={popularLabel}
      />
    );
  })}
</div>

{feedEndpoint && (
  <div id="feed-sentinel" class="h-1" />
)}

{feedEndpoint && (
  <script>
    import { createAdvertisementSlotElement } from "@/shared/lib/ad/mediation";

    const feed = document.getElementById("post-feed");
    const sentinel = document.getElementById("feed-sentinel");

    if (feed && sentinel) {
      const endpoint = feed.dataset.feedEndpoint!;
      let nextPage = parseInt(feed.dataset.nextPage!, 10);
      let hasNext = feed.dataset.hasNext === "true";
      let loading = false;
      let loadedCardCount = Number.parseInt(feed.dataset.initialPostCount || "0", 10);
      const sponsoredLabel = feed.dataset.sponsoredLabel || "";
      const popularLabel = feed.dataset.popularLabel || "";
      const advertisementLabel = feed.dataset.adLabel || "Advertisement";

      const createAdvertisementSlot = (
        positionIndex: number,
        fallbackIndex: number,
      ): HTMLDivElement => {
        return createAdvertisementSlotElement({
          className: "w-full min-h-[250px]",
          slotId: `feed_card_index_${positionIndex}`,
          format: "in_feed",
          position: `feed_card_index_${positionIndex}`,
          placement: "feed",
          advertisementLabel,
          fallbackIndex,
        });
      };

      const createPostCard = (post: any): HTMLElement => {
        const article = document.createElement("article");
        article.className = "group";
        article.dataset.postSlug = post.slug;
        article.dataset.postCategory = post.category;
        article.dataset.postSubCategory = post.subCategory;
        article.dataset.postSponsored = String(post.isSponsored);

        const badgeLabel = post.isSponsored ? sponsoredLabel : post.isRecommended ? popularLabel : "";
        const showBadge = Boolean(badgeLabel);

        let badgeHtml = "";
        if (showBadge) {
          badgeHtml = `<span class="absolute top-3 left-3 inline-flex items-center text-xs font-semibold bg-primary-600 text-white rounded-md px-2.5 py-0.5">${badgeLabel}</span>`;
        }

        const placeHtml = post.placeName
          ? `<span aria-hidden="true">&middot;</span><span>${post.placeName}</span>`
          : "";

        article.innerHTML = `
          <a href="${post.href}" class="block">
            <div class="${showBadge ? "relative " : ""}w-full aspect-7/3 overflow-hidden bg-gray-100">
              <img
                src="${post.thumbnail}"
                alt="${post.thumbnailAlt}"
                width="640"
                height="180"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
                decoding="async"
              />
              ${badgeHtml}
            </div>
            <div class="mt-4 flex flex-col gap-2">
              <h2 class="text-title2 font-bold text-gray-900 line-clamp-2 group-hover:text-primary-600 transition-colors">
                ${post.title}
              </h2>
              <p class="text-body2 text-gray-500 line-clamp-2">${post.description}</p>
              <div class="flex items-center gap-1.5 text-caption1 text-gray-400">
                <time>${post.dateStr}</time>
                ${placeHtml}
                <span aria-hidden="true">&middot;</span>
                <span>${post.categoryLabel}</span>
              </div>
            </div>
          </a>
        `;

        return article;
      };

      const loadNextPage = async () => {
        if (loading || !hasNext) return;
        loading = true;

        try {
          const response = await fetch(`${endpoint}${nextPage}.json`);
          if (!response.ok) {
            hasNext = false;
            sentinel.remove();
            return;
          }

          const responseData = await response.json();
          const posts: any[] = responseData.posts;
          hasNext = responseData.hasNext;

          let localIndex = 0;
          for (const post of posts) {
            if (localIndex === 1 || localIndex === 4) {
              feed.appendChild(
                createAdvertisementSlot(loadedCardCount + localIndex, localIndex === 1 ? 0 : 1),
              );
            }
            feed.appendChild(createPostCard(post));
            localIndex++;
          }
          loadedCardCount += posts.length;

          nextPage++;

          if (!hasNext) {
            sentinel.remove();
          }
        } catch {
          hasNext = false;
          sentinel.remove();
        } finally {
          loading = false;
        }
      };

      if (hasNext) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (entries[0]?.isIntersecting) {
              loadNextPage();
            }
          },
          { rootMargin: "200px" },
        );
        observer.observe(sentinel);
      } else {
        sentinel.remove();
      }
    }
  </script>
)}

<script>
  import { initPostClickTracker } from "@/shared/lib/analytics/post-tracker";
  initPostClickTracker("post-feed");

  const feed = document.getElementById("post-feed");
  const sentinel = document.getElementById("feed-sentinel");

  const skeletonCard = `<div class="animate-pulse max-w-[640px] max-h-[404px] lg:max-w-none lg:max-h-none"><div class="w-full aspect-7/3 bg-gray-200"></div><div class="mt-4 flex flex-col gap-2"><div class="h-5 bg-gray-200 rounded w-3/4"></div><div class="h-4 bg-gray-200 rounded w-full"></div><div class="h-4 bg-gray-200 rounded w-2/3"></div><div class="flex items-center gap-1.5"><div class="h-3 bg-gray-200 rounded w-20"></div><div class="h-3 bg-gray-200 rounded w-16"></div><div class="h-3 bg-gray-200 rounded w-12"></div></div></div></div>`;

  if (feed) {
    document.addEventListener("click", (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>(
        "nav a[href]"
      );
      if (!link || link.getAttribute("aria-current")) return;

      event.preventDefault();
      if (sentinel) sentinel.classList.add("hidden");

      feed.style.width = `${feed.offsetWidth}px`;
      feed.innerHTML = skeletonCard + skeletonCard + skeletonCard;
      window.location.href = link.href;
    });
  }
</script>
