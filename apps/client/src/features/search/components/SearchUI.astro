---
/** 검색 폼, 추천 키워드, 결과 목록, 빈 결과 UI, 클라이언트 검색 스크립트를 포함한 검색 UI. */

import type { SearchItem } from "@/features/search/api/search-data";
import type { Locale } from "@/shared/types/common";
import { t } from "@/shared/lib/i18n/translations";
import {
  ADVERTISEMENT_SLOT_KEY,
  isAdvertisementSlotEnabled,
} from "@/shared/constants/ad";

interface Props {
  searchData: SearchItem[];
  suggestedKeywords: string[];
  placeholderText: string;
  noResultsText: string;
  noResultsHintText: string;
  resultsText: string;
  suggestedText: string;
  sponsoredLabel: string;
  popularLabel: string;
  locale: Locale;
}

const {
  searchData,
  suggestedKeywords,
  placeholderText,
  noResultsText,
  noResultsHintText,
  resultsText,
  suggestedText,
  sponsoredLabel,
  popularLabel,
  locale,
} = Astro.props;

const advertisementLabel = t("a11y.advertisement", locale);
---

<div
  id="search-ui"
  class="w-full max-w-[688px]"
  data-sponsored-label={sponsoredLabel}
  data-popular-label={popularLabel}
  data-results-text={resultsText}
  data-advertisement-label={advertisementLabel}
  data-search-first-enabled={String(isAdvertisementSlotEnabled(ADVERTISEMENT_SLOT_KEY.searchFirst))}
  data-search-second-enabled={String(isAdvertisementSlotEnabled(ADVERTISEMENT_SLOT_KEY.searchSecond))}
>
  <form id="search-form" class="relative" action="" method="get">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
    <input
      type="search"
      id="search-input"
      name="q"
      placeholder={placeholderText}
      autocomplete="off"
      class="w-full h-12 pl-12 pr-10 text-base text-gray-900 bg-transparent border-0 border-b border-gray-200 outline-none focus:border-primary-400 transition-all [&::-webkit-search-cancel-button]:hidden"
    />
    <button
      type="button"
      id="search-clear"
      class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 hover:text-gray-600 transition-colors cursor-pointer hidden"
      aria-label={t("a11y.clearSearch", locale)}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </form>

  <div id="search-suggestions" class="mt-8">
    <p class="text-sm font-semibold text-gray-500 mb-3">{suggestedText}</p>
    <div class="flex flex-wrap gap-2">
      {suggestedKeywords.map((keyword) => (
        <button
          type="button"
          class="search-chip px-3 py-1.5 text-sm text-gray-600 bg-gray-100 hover:bg-primary-50 hover:text-primary-600 transition-colors cursor-pointer"
          data-keyword={keyword}
        >
          {keyword}
        </button>
      ))}
    </div>
  </div>

  <p id="search-count" class="mt-5 text-body2 text-gray-500 hidden"></p>

  <div id="search-results" class="mt-6 flex flex-col gap-10"></div>

  <div id="search-empty" class="mt-16 flex flex-col items-center gap-3 hidden">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-12 h-12 text-gray-300"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
    <p class="text-base font-semibold text-gray-700">{noResultsText}</p>
    <p class="text-sm text-gray-400">{noResultsHintText}</p>
  </div>
</div>

<script
  type="application/json"
  id="search-data"
  set:html={JSON.stringify(searchData)}
/>

<script>
  import { createAdvertisementSlotElement } from "@/shared/lib/ad/mediation";
  import { unobserveAdSlotsWithin } from "@/shared/lib/analytics/ad-tracker";

  const searchUi = document.getElementById('search-ui');
  const searchDataElement = document.getElementById('search-data');
  const searchForm = document.getElementById('search-form');
  const searchInput = document.querySelector<HTMLInputElement>('#search-input');
  const resultsContainer = document.getElementById('search-results');
  const searchCount = document.getElementById('search-count');
  const emptyState = document.getElementById('search-empty');
  const suggestions = document.getElementById('search-suggestions');
  const sponsoredLabel = searchUi?.dataset.sponsoredLabel ?? '';
  const popularLabel = searchUi?.dataset.popularLabel ?? '';
  const resultsText = searchUi?.dataset.resultsText ?? '';
  const advertisementLabel = searchUi?.dataset.advertisementLabel ?? 'Advertisement';
  const searchFirstAdvertisementEnabled = searchUi?.dataset.searchFirstEnabled === 'true';
  const searchSecondAdvertisementEnabled = searchUi?.dataset.searchSecondEnabled === 'true';

  const clearButton = document.getElementById('search-clear');
  const posts = JSON.parse(searchDataElement?.textContent || '[]');

  const toggleClearButton = () => {
    if (!clearButton) return;
    clearButton.classList.toggle('hidden', !searchInput?.value);
  };

  searchInput?.addEventListener('input', toggleClearButton);
  clearButton?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    toggleClearButton();
    renderResults('');
    searchInput?.focus();
  });

  let searchRenderSequence = 0;

  const createAdvertisementSlot = (
    renderSequence: number,
    positionIndex: number,
    slotKey: 'search.first' | 'search.second',
    fallbackIndex: number,
  ) => {
    const advertisementIdentifier = `search_render_${renderSequence}_card_index_${positionIndex}`;
    return createAdvertisementSlotElement({
      className: 'w-full min-h-[280px]',
      slotId: advertisementIdentifier,
      format: 'in_feed',
      position: advertisementIdentifier,
      slotKey,
      advertisementLabel,
      fallbackIndex,
    });
  };

  const createPostCard = (post) => {
    const article = document.createElement('article');
    article.className = 'group';
    article.dataset.postSlug = post.slug;
    article.dataset.postCategory = post.category;
    article.dataset.postSubCategory = post.subCategory;
    article.dataset.postSponsored = String(post.isSponsored);

    const badgeLabel = post.isSponsored ? sponsoredLabel : post.isRecommended ? popularLabel : '';
    const showBadge = Boolean(badgeLabel);

    let badgeHtml = '';
    if (showBadge) {
      badgeHtml = `<span class="absolute top-3 left-3 inline-flex items-center text-xs font-semibold bg-primary-600 text-white rounded-md px-2.5 py-0.5">${badgeLabel}</span>`;
    }

    const placeHtml = post.placeName
      ? `<span aria-hidden="true">&middot;</span><span>${post.placeName}</span>`
      : '';

    article.innerHTML = `
      <a href="${post.href}" class="block">
        <div class="${showBadge ? 'relative ' : ''}w-full aspect-7/3 overflow-hidden bg-gray-100">
          <img
            src="${post.thumbnail}"
            alt="${post.thumbnailAlt}"
            width="640"
            height="180"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
            decoding="async"
          />
          ${badgeHtml}
        </div>
        <div class="mt-4 flex flex-col gap-2">
          <h2 class="text-title2 font-bold text-gray-900 line-clamp-2 group-hover:text-primary-600 transition-colors">
            ${post.title}
          </h2>
          <p class="text-body2 text-gray-500 line-clamp-2">${post.description}</p>
          <div class="flex items-center gap-1.5 text-caption1 text-gray-400">
            <time>${post.dateStr}</time>
            ${placeHtml}
            <span aria-hidden="true">&middot;</span>
            <span>${post.categoryLabel}</span>
          </div>
        </div>
      </a>
    `;

    return article;
  };

  const renderResults = (query) => {
    if (!resultsContainer || !searchCount || !emptyState) return;
    unobserveAdSlotsWithin(resultsContainer);
    resultsContainer.innerHTML = '';
    searchRenderSequence++;
    const normalizedQuery = query.trim().toLowerCase();

    if (!normalizedQuery) {
      searchCount.classList.add('hidden');
      emptyState.classList.add('hidden');
      suggestions?.classList.remove('hidden');
      return;
    }

    suggestions?.classList.add('hidden');

    const filtered = posts.filter((post) =>
      post.title.toLowerCase().includes(normalizedQuery) ||
      post.description.toLowerCase().includes(normalizedQuery) ||
      (post.placeName && post.placeName.toLowerCase().includes(normalizedQuery))
    );

    if (filtered.length === 0) {
      searchCount.classList.add('hidden');
      emptyState.classList.remove('hidden');
      return;
    }

    emptyState.classList.add('hidden');
    searchCount.textContent = `${filtered.length}${resultsText}`;
    searchCount.classList.remove('hidden');

    let cardIndex = 0;
    for (const post of filtered) {
      const slotKey =
        cardIndex === 1
          ? 'search.first'
          : cardIndex === 4
            ? 'search.second'
            : null;
      const slotEnabled =
        (slotKey === 'search.first' && searchFirstAdvertisementEnabled) ||
        (slotKey === 'search.second' && searchSecondAdvertisementEnabled);
      if (slotKey && slotEnabled) {
        const advertisementSlot = createAdvertisementSlot(
          searchRenderSequence,
          cardIndex,
          slotKey,
          slotKey === 'search.first' ? 0 : 1,
        );
        if (advertisementSlot) {
          resultsContainer.appendChild(advertisementSlot);
        }
      }
      resultsContainer.appendChild(createPostCard(post));
      cardIndex++;
    }
  };

  const doSearch = (query) => {
    if (searchInput) searchInput.value = query;
    toggleClearButton();
    renderResults(query);
    const url = new URL(window.location.href);
    const trimmed = query.trim();
    if (trimmed) {
      url.searchParams.set('q', trimmed);
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'search', { search_term: trimmed });
      }
    } else {
      url.searchParams.delete('q');
    }
    history.replaceState(null, '', url.toString());
  };

  const searchParameters = new URLSearchParams(window.location.search);
  const initialQuery = searchParameters.get('q') || '';
  if (searchInput) searchInput.value = initialQuery;
  if (initialQuery) renderResults(initialQuery);
  toggleClearButton();

  searchForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    doSearch(searchInput?.value || '');
  });

  document.querySelectorAll('.search-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      doSearch(chip.dataset.keyword || '');
    });
  });
</script>

<script>
  import { initPostClickTracker } from "@/shared/lib/analytics/post-tracker";
  initPostClickTracker("search-results");
</script>
